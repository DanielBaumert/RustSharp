using System.Runtime.InteropServices;
using System.Threading;
using System.Threading.Tasks;
using System.IO;
using TaskRuntime = System.Threading.Tasks.Runtime;

namespace System.Net.Sockets
{
    internal sealed unsafe class ReceiveFromTask : IoTask<(int Length, string Host, int Port)>
    {
        private Arc<SocketHandle> _socket;
        private byte* _p;
        private int _n;
        public ReceiveFromTask(Arc<SocketHandle> s, byte* p, int n) { _socket = s; _p = p; _n = n; }
        internal override bool PollCore()
        {
            int fd = _socket.Value.Fd;
            while (true)
            {
                Sockaddr from = default;
                uint len = 112;
                long r = UdpSocket.recvfrom(fd, _p, _n, 0, &from, &len);
                if (r >= 0)
                {
                    return Done(((int)r, Address.Host(&from), Address.Port(&from)));
                }
                int e = Sys.Errno;
                if (e == Sys.EINTR) continue;
                if (e == Sys.EAGAIN)
                {
                    if (Reactor.Wait(fd, false)) return false;
                    continue;
                }
                return Fail(Address.ErrorText("recvfrom"));
            }
        }
    }
}
