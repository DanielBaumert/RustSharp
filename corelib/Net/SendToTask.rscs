using System.Runtime.InteropServices;
using System.Threading;
using System.Threading.Tasks;
using System.IO;
using TaskRuntime = System.Threading.Tasks.Runtime;

namespace System.Net.Sockets
{
    internal sealed unsafe class SendToTask : IoTask<int>
    {
        private Arc<SocketHandle> _socket;
        private byte* _p;
        private int _n;
        private Sockaddr _to;
        public SendToTask(Arc<SocketHandle> s, byte* p, int n, Sockaddr to) { _socket = s; _p = p; _n = n; _to = to; }
        internal override bool PollCore()
        {
            int fd = _socket.Value.Fd;
            while (true)
            {
                long r = UdpSocket.sendto(fd, _p, _n, 0x4000, Mem.AddressOf(in _to), (uint)_to.Length);
                if (r >= 0)
                {
                    return Done((int)r);
                }
                int e = Sys.Errno;
                if (e == Sys.EINTR) continue;
                if (e == Sys.EAGAIN)
                {
                    if (Reactor.Wait(fd, true)) return false;
                    continue;
                }
                return Fail(Address.ErrorText("sendto"));
            }
        }
    }
}
