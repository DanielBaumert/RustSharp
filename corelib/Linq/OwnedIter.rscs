namespace System.Linq
{
    /// <summary>Iterates a list it owns, for results that had to be materialized.</summary>
    public unsafe ref struct OwnedIter<T> : IIter<T>
    {
        private System.Collections.Generic.List<T> _list;
        private int _i;
        internal OwnedIter(System.Collections.Generic.List<T> list) { _list = list; }
        public T* Next()
        {
            if (_i >= _list.Count) return null;
            return _list.Data + _i++;
        }
    }
}
