namespace System.Linq
{
    /// <summary>Hands out the elements of a list it owns, like Vec::into_iter. What is left is dropped with it.</summary>
    public ref struct OwnedIter<T> : IIter<T>
    {
        private System.Collections.Generic.List<T> _reversed;
        internal OwnedIter(System.Collections.Generic.List<T> list) { list.Reverse(); _reversed = list; }
        public Option<T> Next() => _reversed.Pop();
    }
}
