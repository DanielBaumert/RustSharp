namespace System.Linq
{
    public ref struct SelectManyIter<T, U, I> : IIter<U> where I : IIter<T>, allows ref struct
    {
        private I _inner;
        private Selector<T, System.Collections.Generic.List<U>> _map;
        private System.Collections.Generic.List<U> _reversed;
        internal SelectManyIter(I inner, Selector<T, System.Collections.Generic.List<U>> map) { _inner = inner; _map = map; _reversed = new System.Collections.Generic.List<U>(); }
        public Option<U> Next()
        {
            while (true)
            {
                var item = _reversed.Pop();
                if (item.IsSome) return item;
                var source = _inner.Next();
                if (source.IsNone) return Option<U>.None;
                var next = _map(source.Unwrap());
                next.Reverse();
                _reversed = next;
            }
        }
    }
}
