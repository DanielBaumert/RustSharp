namespace System.Linq
{
    public unsafe ref partial struct Query<T, I> where I : IIter<T>, allows ref struct
    {
        /// <summary>Some only when there is exactly one item.</summary>
        public move Option<T> Single()
        {
            var item = _it.Next();
            if (item.IsNone) return item;
            if (_it.Next().IsSome) return Option<T>.None;
            return item;
        }

        /// <summary>The largest item; of several equal ones the last, as in Rust.</summary>
        public move Option<T> Max()
        {
            var best = _it.Next();
            if (best.IsNone) return best;
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return best;
                if (Mem.CompareOf(in item.Slot, in best.Slot) >= 0) best = item;
            }
        }

        /// <summary>The smallest item; of several equal ones the first, as in Rust.</summary>
        public move Option<T> Min()
        {
            var best = _it.Next();
            if (best.IsNone) return best;
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return best;
                if (Mem.CompareOf(in item.Slot, in best.Slot) < 0) best = item;
            }
        }

        public move int Count()
        {
            int n = 0;
            while (_it.Next().IsSome) n++;
            return n;
        }

        public move bool Any() => _it.Next().IsSome;

        public move bool Any(Predicate<T> test)
        {
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return false;
                if (test(in item.Slot)) return true;
            }
        }

        public move bool All(Predicate<T> test)
        {
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return true;
                if (!test(in item.Slot)) return false;
            }
        }

        public move A Aggregate<A>(A seed, Accumulator<A, T> step)
        {
            A acc = seed;
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return acc;
                acc = step(acc, item.Unwrap());
            }
        }

        public move void ForEach(Consumer<T> visit)
        {
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return;
                visit(item.Unwrap());
            }
        }

        public move Option<T> First() => _it.Next();

        public move Option<T> Last()
        {
            var last = Option<T>.None;
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return last;
                last = item;
            }
        }

        /// <summary>Rust's collect into a Vec: the items are moved, not cloned.</summary>
        public move System.Collections.Generic.List<T> ToList()
        {
            var list = new System.Collections.Generic.List<T>();
            while (true)
            {
                var item = _it.Next();
                if (item.IsNone) return list;
                list.Add(item.Unwrap());
            }
        }

        public move T[] ToArray()
        {
            var list = ToList();
            T[] array = Mem.UninitArray<T>(list.Count);
            for (int i = 0; i < array.Length; i++) Mem.Write(Mem.AddressOf(in array[i]), list.ReadOut(i));
            list.ForgetAll();
            return array;
        }

        public move Enumerator GetEnumerator() => new Enumerator(_it);

        /// <summary>For foreach: each step hands its item over to the loop variable.</summary>
        public ref struct Enumerator
        {
            private I _it;
            private Option<T> _current;
            internal Enumerator(I it) { _it = it; _current = Option<T>.None; }
            public bool MoveNext() { _current = _it.Next(); return _current.IsSome; }
            // foreach reads Current once per step, so taking the item out is safe; a second read panics.
            public readonly T Current => Mem.AsRef(Mem.AddressOf(in _current)).Take().Unwrap();
        }
    }
}
