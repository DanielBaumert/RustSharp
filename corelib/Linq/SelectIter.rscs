namespace System.Linq
{
    public ref struct SelectIter<T, U, I> : IIter<U> where I : IIter<T>, allows ref struct
    {
        private I _inner;
        private Selector<T, U> _map;
        internal SelectIter(I inner, Selector<T, U> map) { _inner = inner; _map = map; }
        public Option<U> Next()
        {
            var item = _inner.Next();
            if (item.IsNone) return Option<U>.None;
            return Option<U>.Some(_map(item.Unwrap()));
        }
    }
}
