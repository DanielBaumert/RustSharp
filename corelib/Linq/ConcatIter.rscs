namespace System.Linq
{
    public ref struct ConcatIter<T, I, J> : IIter<T> where I : IIter<T>, allows ref struct where J : IIter<T>, allows ref struct
    {
        private I _first;
        private J _second;
        private bool _inSecond;
        internal ConcatIter(I first, J second) { _first = first; _second = second; }
        public Option<T> Next()
        {
            if (!_inSecond)
            {
                var item = _first.Next();
                if (item.IsSome) return item;
                _inSecond = true;
            }
            return _second.Next();
        }
    }
}
