namespace System.Linq
{
    public unsafe ref struct WhileIter<T, I> : IIter<T> where I : IIter<T>, allows ref struct
    {
        private I _inner;
        private Predicate<T> _test;
        private bool _take;
        private bool _switched;
        internal WhileIter(I inner, Predicate<T> test, bool take) { _inner = inner; _test = test; _take = take; }
        public T* Next()
        {
            while (true)
            {
                T* item = _inner.Next();
                if (item == null) return null;
                if (_take) return _test(in *item) ? item : null;
                if (_switched) return item;
                if (!_test(in *item))
                {
                    _switched = true;
                    return item;
                }
            }
        }
    }
}
