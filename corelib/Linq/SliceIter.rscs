namespace System.Linq
{
    /// <summary>Lends the elements of a list or array in order: Rust's slice::Iter, items are &amp;T.</summary>
    public unsafe ref struct SliceIter<T> : IIter<Ref<T>>
    {
        private T* _p;
        private T* _end;
        internal SliceIter(T* p, int n) { _p = p; _end = p + n; }
        public Option<Ref<T>> Next()
        {
            if (_p == _end) return Option<Ref<T>>.None;
            T* item = _p;
            _p = _p + 1;
            return Option<Ref<T>>.Some(Ref<T>.Of(in *item));
        }
    }
}
