namespace System.Linq
{
    public unsafe ref struct SliceIter<T> : IIter<T>
    {
        private T* _p;
        private T* _end;
        internal SliceIter(T* p, int n) { _p = p; _end = p + n; }
        public T* Next() { if (_p == _end) return null; T* item = _p; _p = _p + 1; return item; }
    }
}
