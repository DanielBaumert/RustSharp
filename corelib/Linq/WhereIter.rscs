namespace System.Linq
{
    public unsafe ref struct WhereIter<T, I> : IIter<T> where I : IIter<T>, allows ref struct
    {
        private I _inner;
        private Predicate<T> _keep;
        internal WhereIter(I inner, Predicate<T> keep) { _inner = inner; _keep = keep; }
        public T* Next()
        {
            while (true)
            {
                T* item = _inner.Next();
                if (item == null || _keep(in *item)) return item;
            }
        }
    }
}
