namespace System.Linq
{
    public ref struct WhereIter<T, I> : IIter<T> where I : IIter<T>, allows ref struct
    {
        private I _inner;
        private Predicate<T> _keep;
        internal WhereIter(I inner, Predicate<T> keep) { _inner = inner; _keep = keep; }
        public Option<T> Next()
        {
            while (true)
            {
                var item = _inner.Next();
                if (item.IsNone || _keep(in item.Slot)) return item;
            }
        }
    }
}
