namespace System.Linq
{
    /// <summary>
    /// Queries on lists and arrays lend their elements as Ref&lt;T&gt;, like Rust's <c>v.iter()</c>, and borrow
    /// the collection for as long as they live.
    /// </summary>
    public static unsafe class Enumerable
    {
        public static Query<int, RangeIter> Range(int start, int count)
            => new Query<int, RangeIter>(new RangeIter(start, count));

        private static SliceIter<T> Slice<T>(in System.Collections.Generic.List<T> list) => new SliceIter<T>(list.Data, list.Count);
        private static SliceIter<T> Slice<T>(in T[] array) => new SliceIter<T>(array.Length == 0 ? null : Mem.AddressOf(in array[0]), array.Length);

        public static 'a Query<Ref<T>, SliceIter<T>> AsQuery<T>(this in 'a System.Collections.Generic.List<T> c) => new Query<Ref<T>, SliceIter<T>>(Slice(in c));
        public static 'a Query<Ref<T>, WhereIter<Ref<T>, SliceIter<T>>> Where<T>(this in 'a System.Collections.Generic.List<T> c, 'a Predicate<Ref<T>> keep) => c.AsQuery().Where(keep);
        public static 'a Query<U, SelectIter<Ref<T>, U, SliceIter<T>>> Select<T, U>(this in 'a System.Collections.Generic.List<T> c, 'a Selector<Ref<T>, U> map) => c.AsQuery().Select(map);
        public static 'a Query<Ref<T>, TakeIter<Ref<T>, SliceIter<T>>> Take<T>(this in 'a System.Collections.Generic.List<T> c, int n) => c.AsQuery().Take(n);
        public static 'a Query<Ref<T>, SkipIter<Ref<T>, SliceIter<T>>> Skip<T>(this in 'a System.Collections.Generic.List<T> c, int n) => c.AsQuery().Skip(n);
        public static bool Any<T>(this in System.Collections.Generic.List<T> c, Predicate<Ref<T>> test) => c.AsQuery().Any(test);
        public static bool All<T>(this in System.Collections.Generic.List<T> c, Predicate<Ref<T>> test) => c.AsQuery().All(test);
        public static int Count<T>(this in System.Collections.Generic.List<T> c, Predicate<Ref<T>> test) => c.AsQuery().Count(test);
        public static 'a Option<Ref<T>> First<T>(this in 'a System.Collections.Generic.List<T> c) => c.AsQuery().First();
        public static 'a Option<Ref<T>> Last<T>(this in 'a System.Collections.Generic.List<T> c) => c.AsQuery().Last();
        public static 'a Option<Ref<T>> Max<T>(this in 'a System.Collections.Generic.List<T> c) => c.AsQuery().Max();
        public static 'a Option<Ref<T>> Min<T>(this in 'a System.Collections.Generic.List<T> c) => c.AsQuery().Min();
        /// <summary>A copy of the collection, like Rust's to_vec(): the elements are cloned.</summary>
        public static System.Collections.Generic.List<T> ToList<T>(this in System.Collections.Generic.List<T> c) => c.AsQuery().Cloned().ToList();
        public static 'a Query<Ref<T>, OwnedIter<Ref<T>>> OrderBy<T, K>(this in 'a System.Collections.Generic.List<T> c, 'a KeySelector<Ref<T>, K> key) => c.AsQuery().OrderBy(key);
        public static 'a Query<Ref<T>, OwnedIter<Ref<T>>> OrderByDescending<T, K>(this in 'a System.Collections.Generic.List<T> c, 'a KeySelector<Ref<T>, K> key) => c.AsQuery().OrderByDescending(key);
        public static 'a Query<Ref<T>, OwnedIter<Ref<T>>> Distinct<T>(this in 'a System.Collections.Generic.List<T> c) => c.AsQuery().Distinct();
        public static 'a System.Collections.Generic.Dictionary<K, System.Collections.Generic.List<Ref<T>>> GroupBy<T, K>(this in 'a System.Collections.Generic.List<T> c, 'a KeySelector<Ref<T>, K> key) => c.AsQuery().GroupBy(key);

        public static 'a Query<Ref<T>, SliceIter<T>> AsQuery<T>(this in 'a T[] c) => new Query<Ref<T>, SliceIter<T>>(Slice(in c));
        public static 'a Query<Ref<T>, WhereIter<Ref<T>, SliceIter<T>>> Where<T>(this in 'a T[] c, 'a Predicate<Ref<T>> keep) => c.AsQuery().Where(keep);
        public static 'a Query<U, SelectIter<Ref<T>, U, SliceIter<T>>> Select<T, U>(this in 'a T[] c, 'a Selector<Ref<T>, U> map) => c.AsQuery().Select(map);
        public static 'a Query<Ref<T>, TakeIter<Ref<T>, SliceIter<T>>> Take<T>(this in 'a T[] c, int n) => c.AsQuery().Take(n);
        public static 'a Query<Ref<T>, SkipIter<Ref<T>, SliceIter<T>>> Skip<T>(this in 'a T[] c, int n) => c.AsQuery().Skip(n);
        public static bool Any<T>(this in T[] c, Predicate<Ref<T>> test) => c.AsQuery().Any(test);
        public static bool All<T>(this in T[] c, Predicate<Ref<T>> test) => c.AsQuery().All(test);
        public static int Count<T>(this in T[] c, Predicate<Ref<T>> test) => c.AsQuery().Count(test);
        public static 'a Option<Ref<T>> First<T>(this in 'a T[] c) => c.AsQuery().First();
        public static 'a Option<Ref<T>> Last<T>(this in 'a T[] c) => c.AsQuery().Last();
        public static 'a Option<Ref<T>> Max<T>(this in 'a T[] c) => c.AsQuery().Max();
        public static 'a Option<Ref<T>> Min<T>(this in 'a T[] c) => c.AsQuery().Min();
        /// <summary>A copy of the collection, like Rust's to_vec(): the elements are cloned.</summary>
        public static System.Collections.Generic.List<T> ToList<T>(this in T[] c) => c.AsQuery().Cloned().ToList();
        public static 'a Query<Ref<T>, OwnedIter<Ref<T>>> OrderBy<T, K>(this in 'a T[] c, 'a KeySelector<Ref<T>, K> key) => c.AsQuery().OrderBy(key);
        public static 'a Query<Ref<T>, OwnedIter<Ref<T>>> OrderByDescending<T, K>(this in 'a T[] c, 'a KeySelector<Ref<T>, K> key) => c.AsQuery().OrderByDescending(key);
        public static 'a Query<Ref<T>, OwnedIter<Ref<T>>> Distinct<T>(this in 'a T[] c) => c.AsQuery().Distinct();
        public static 'a System.Collections.Generic.Dictionary<K, System.Collections.Generic.List<Ref<T>>> GroupBy<T, K>(this in 'a T[] c, 'a KeySelector<Ref<T>, K> key) => c.AsQuery().GroupBy(key);

        /// <summary>Rust's cloned(): owned clones of borrowed items.</summary>
        public static 'a Query<T, ClonedIter<T, I>> Cloned<T, I>(this 'a Query<Ref<T>, I> q) where I : IIter<Ref<T>>, allows ref struct
            => new Query<T, ClonedIter<T, I>>(new ClonedIter<T, I>(q.Inner()));
        /// <summary>Rust's copied(): like Cloned, for Copy types only.</summary>
        public static 'a Query<T, ClonedIter<T, I>> Copied<[Copy] T, I>(this 'a Query<Ref<T>, I> q) where I : IIter<Ref<T>>, allows ref struct
            => new Query<T, ClonedIter<T, I>>(new ClonedIter<T, I>(q.Inner()));

        /// <summary>Whether a borrowed item equals <paramref name="value"/>, like Rust's slice contains(&amp;x).</summary>
        public static bool Contains<T, I>(this Query<Ref<T>, I> q, in T value) where I : IIter<Ref<T>>, allows ref struct
        {
            while (true)
            {
                var item = q.Next();
                if (item.IsNone) return false;
                if (Mem.EqualOf(in item.Unwrap().Value, in value)) return true;
            }
        }

        public static 'a Query<U, SelectManyIter<T, U, I>> SelectMany<T, U, I>(this 'a Query<T, I> q, 'a Selector<T, System.Collections.Generic.List<U>> f) where I : IIter<T>, allows ref struct
            => new Query<U, SelectManyIter<T, U, I>>(new SelectManyIter<T, U, I>(q.Inner(), f));
        public static int Sum<I>(this Query<int, I> q) where I : IIter<int>, allows ref struct => q.Aggregate(0, (a, x) => a + x);
        public static int Sum<I>(this Query<Ref<int>, I> q) where I : IIter<Ref<int>>, allows ref struct => q.Aggregate(0, (a, x) => a + x);
        public static long Sum<I>(this Query<long, I> q) where I : IIter<long>, allows ref struct => q.Aggregate(0L, (a, x) => a + x);
        public static long Sum<I>(this Query<Ref<long>, I> q) where I : IIter<Ref<long>>, allows ref struct => q.Aggregate(0L, (a, x) => a + x);
        public static double Sum<I>(this Query<double, I> q) where I : IIter<double>, allows ref struct => q.Aggregate(0.0, (a, x) => a + x);
        public static double Sum<I>(this Query<Ref<double>, I> q) where I : IIter<Ref<double>>, allows ref struct => q.Aggregate(0.0, (a, x) => a + x);
        public static decimal Sum<I>(this Query<decimal, I> q) where I : IIter<decimal>, allows ref struct => q.Aggregate(0m, (a, x) => a + x);
        public static decimal Sum<I>(this Query<Ref<decimal>, I> q) where I : IIter<Ref<decimal>>, allows ref struct => q.Aggregate(0m, (a, x) => a + x);
        public static Option<double> Average<I>(this Query<int, I> q) where I : IIter<int>, allows ref struct
        {
            var sum = q.Aggregate((0L, 0), (a, x) => (a.Item1 + x, a.Item2 + 1));
            if (sum.Item2 == 0) return Option<double>.None;
            return Option<double>.Some((double)sum.Item1 / sum.Item2);
        }
        public static Option<double> Average<I>(this Query<Ref<int>, I> q) where I : IIter<Ref<int>>, allows ref struct
        {
            var sum = q.Aggregate((0L, 0), (a, x) => (a.Item1 + x, a.Item2 + 1));
            if (sum.Item2 == 0) return Option<double>.None;
            return Option<double>.Some((double)sum.Item1 / sum.Item2);
        }
        public static Option<double> Average<I>(this Query<double, I> q) where I : IIter<double>, allows ref struct
        {
            var sum = q.Aggregate((0.0, 0), (a, x) => (a.Item1 + x, a.Item2 + 1));
            if (sum.Item2 == 0) return Option<double>.None;
            return Option<double>.Some(sum.Item1 / sum.Item2);
        }
        public static Option<double> Average<I>(this Query<Ref<double>, I> q) where I : IIter<Ref<double>>, allows ref struct
        {
            var sum = q.Aggregate((0.0, 0), (a, x) => (a.Item1 + x, a.Item2 + 1));
            if (sum.Item2 == 0) return Option<double>.None;
            return Option<double>.Some(sum.Item1 / sum.Item2);
        }
    }
}
