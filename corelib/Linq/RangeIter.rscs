namespace System.Linq
{
    public ref struct RangeIter : IIter<int>
    {
        private int _next;
        private int _end;
        internal RangeIter(int start, int count) { _next = start; _end = start + count; }
        public Option<int> Next()
        {
            if (_next == _end) return Option<int>.None;
            return Option<int>.Some(_next++);
        }
    }
}
