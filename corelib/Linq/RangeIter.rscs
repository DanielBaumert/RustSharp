namespace System.Linq
{
    public unsafe ref struct RangeIter : IIter<int>
    {
        private int _next;
        private int _end;
        private int _current;
        internal RangeIter(int start, int count) { _next = start; _end = start + count; }
        public int* Next()
        {
            if (_next == _end) return null;
            _current = _next;
            _next++;
            return Mem.AddressOf(in _current);
        }
    }
}
