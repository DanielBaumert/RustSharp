namespace System.Collections.Generic
{
    /// <summary>Rust's HashSet.</summary>
    [SendWhen(Bound.Send), SyncWhen(Bound.Sync)]
    [CarriesBorrows]
    public class HashSet<T>
    {
        private Dictionary<T, bool> _map = new Dictionary<T, bool>();
        public readonly int Count => _map.Count;
        public readonly bool Contains(in T item) => _map.ContainsKey(in item);

        /// <summary>False if the item was already there.</summary>
        public bool Add(T item)
        {
            if (_map.ContainsKey(in item)) return false;
            _map.Set(item, true);
            return true;
        }

        public bool Remove(in T item) => _map.Remove(in item).IsSome;
    }
}
