using System.Runtime.CompilerServices;

namespace System.Threading.Tasks
{
    internal sealed class AllTask : Task
    {
        private Task[] _tasks;
        public AllTask(Task[] tasks) { _tasks = tasks; }
        internal override bool PollCore()
        {
            bool all = true;
            for (int i = 0; i < _tasks.Length; i++)
                if (!_tasks[i].Poll()) all = false;
            if (!all) return false;
            return true;
        }
    }
}
