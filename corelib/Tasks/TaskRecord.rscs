using System.Runtime.CompilerServices;

namespace System.Threading.Tasks
{
    /// <summary>A task known to the scheduler. Wakers count references to it.</summary>
    internal unsafe struct TaskRecord
    {
        public long Refs;
        public long Owner; // a Worker*, atomic: the first worker to run the task sets it
        public int Queued;
        public int Finished;
        public int Pinned;
        public int Running;
        public int Root;
        public int Cancel;
        public IJob Job;
        public TaskRecord* Previous;
        public TaskRecord* Next;
    }
}
