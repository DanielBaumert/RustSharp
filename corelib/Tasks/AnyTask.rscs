using System.Runtime.CompilerServices;

namespace System.Threading.Tasks
{
    internal sealed class AnyTask : Task<int>
    {
        private Task[] _tasks;
        public AnyTask(Task[] tasks) { _tasks = tasks; }
        internal override bool PollCore()
        {
            for (int i = 0; i < _tasks.Length; i++)
            {
                if (_tasks[i].Poll())
                {
                    _result = Some(i);
                    _tasks = new Task[0];
                    return true;
                }
            }
            return false;
        }
    }
}
