namespace System
{
    /// <summary>Rust's Hash, written by hand.</summary>
    public interface IHash { readonly int Hash(); }

    /// <summary>Rust's Ord, written by hand: negative, zero or positive.</summary>
    public interface IOrd<T> { readonly int Compare(in T other); }

    public static class CloneExtensions
    {
        public static T Clone<T>(this in T value) => Mem.CloneOf(in value);
    }

    [BorrowHolder] public interface IDisposable { void Dispose(); }
    [BorrowHolder] public interface IAsyncDisposable { System.Threading.Tasks.ValueTask DisposeAsync(); }

    public static class Activator { public static extern T CreateInstance<T>(); }

    [CarriesBorrows]
    public struct ValueTuple<T1, T2>
    {
        public T1 Item1;
        public T2 Item2;
        public ValueTuple(T1 a, T2 b) { Item1 = a; Item2 = b; }
    }

    [CarriesBorrows]
    public struct ValueTuple<T1, T2, T3>
    {
        public T1 Item1;
        public T2 Item2;
        public T3 Item3;
        public ValueTuple(T1 a, T2 b, T3 c) { Item1 = a; Item2 = b; Item3 = c; }
    }

    [CarriesBorrows]
    public struct ValueTuple<T1, T2, T3, T4>
    {
        public T1 Item1;
        public T2 Item2;
        public T3 Item3;
        public T4 Item4;
        public ValueTuple(T1 a, T2 b, T3 c, T4 d) { Item1 = a; Item2 = b; Item3 = c; Item4 = d; }
    }

    public readonly partial struct Boolean
    {
        public override string ToString() => this ? "True" : "False";
    }
}
