namespace System.Text
{
    /// <summary>Decodes UTF-8 one char at a time: String.Chars().</summary>
    public unsafe ref struct CharsIter : System.Linq.IIter<Rune>
    {
        private byte* _p;
        private byte* _end;
        private Rune _current;
        internal CharsIter(byte* p, int n) { _p = p; _end = p + n; _current = default; }
        public Rune* Next()
        {
            if (_p >= _end) return null;
            _current = Rune.Decode(_p, (int)(_end - _p), out int used);
            _p += used;
            return Mem.AddressOf(in _current);
        }
    }
}
