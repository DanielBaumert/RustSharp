namespace System.Text
{
    /// <summary>Decodes UTF-8 one char at a time: String.Chars().</summary>
    public unsafe ref struct CharsIter : System.Linq.IIter<Rune>
    {
        private byte* _p;
        private byte* _end;
        internal CharsIter(byte* p, int n) { _p = p; _end = p + n; }
        public Option<Rune> Next()
        {
            if (_p >= _end) return Option<Rune>.None;
            Rune r = Rune.Decode(_p, (int)(_end - _p), out int used);
            _p += used;
            return Option<Rune>.Some(r);
        }
    }
}
