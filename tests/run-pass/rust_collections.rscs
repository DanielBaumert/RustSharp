using System;
using System.Collections.Generic;
using System.Linq;
class P
{
    static void Main()
    {
        // Vec
        mut var v = new List<int>();
        v.Push(3); v.Push(1); v.Push(3); v.Push(3); v.Push(2);
        Console.WriteLine(v.Len + " " + v.Pop().Unwrap() + " " + v.Get(0).Unwrap().Value + " " + v.Get(9).IsNone);
        v.GetMut(1).Unwrap().Value = 5;
        v.Dedup();
        Console.WriteLine(string.Join(",", v));
        v.Retain((in int x) => x != 5);
        v.Swap(0, v.Len - 1);
        Console.WriteLine(v.SwapRemove(0) + " " + v.Len);
        mut var more = new List<int>();
        more.Push(7); more.Push(8);
        v.Extend(more);
        v.Truncate(2);
        Console.WriteLine(v.Iter().Map(x => x * 10).Collect().Count + " " + v.IsEmpty);

        // HashMap
        mut var counts = new Dictionary<string, int>();
        foreach (var word in "a b a c a".Split(' ')) counts.OrInsert(word.ToOwned(), 0) += 1;
        Console.WriteLine(counts.Get("a").Unwrap().Value + " " + counts.Get("z").IsNone + " " + counts.Len);
        counts.GetMut("b").Unwrap().Value = 10;
        Console.WriteLine(counts.Insert("b", 2).Unwrap() + " " + counts["b"]);
        Console.WriteLine(counts.Keys().Count + counts.Values().AsQuery().Sum());

        // Iterator
        mut var nums = new List<int>();
        for (mut int i = 1; i <= 6; i++) nums.Push(i);
        Console.WriteLine(nums.Iter().Filter((in int x) => x % 2 == 0).Fold(0, (acc, in x) => acc + x));
        Console.WriteLine(nums.Iter().Position((in int x) => x == 4).Unwrap() + " " + nums.Iter().Nth(2).Unwrap() + " " + nums.Iter().Find((in int x) => x > 4).Unwrap());
        foreach (var (i, x) in nums.Iter().Enumerate().Take(2)) Console.Write(i + ":" + x + " ");
        Console.WriteLine();
        Console.WriteLine(string.Join(",", nums.Iter().StepBy(2).Collect()) + " " + nums.Iter().Rev().First().Unwrap());
    }
}
