using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;
class C { public int V; public async Task<int> Get() { await Task.Yield(); return V; } }
class P
{
    static async Task Use(C c) { await Task.Yield(); }
    static async Task Borrows()
    {
        mut var c = new C();
        var t = c.Get();
        var moved = c; // error: CS9906
        await t;

        mut var d = new C();
        await Use(d);
        d.V = 1; // error: CS9900
    }
    static async Task<int> One() { await Task.Yield(); return 1; }
    static async Task Held()
    {
        var m = new Mutex<int>(1);
        var again = One();
        var first = await again;
        var second = await again; // error: CS9900
    }
    static void Main()
    {
        int n = 1;
        var u = Task.Run(() => One2(n)); // error: CS9925
    }
    static async Task<int> One2(int n) { await Task.Yield(); return n; }
}
