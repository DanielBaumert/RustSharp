using System;
using System.Net.Sockets;
using System.Threading.Tasks;
class P
{
    static async Task Bad(TcpStream s)
    {
        mut byte[] buf = new byte[16];
        var read = s.ReadAsync(ref buf);
        buf[0] = 1; // error: CS9907
        await read;

        mut byte[] other = new byte[16];
        var write = s.WriteAsync(in other, 16);
        other = new byte[1]; // error: CS9907
        await write;
    }
    static void Main()
    {
        var l = TcpListener.Bind("127.0.0.1", 0).Unwrap();
        var moved = l;
        Console.WriteLine(l.LocalPort); // error: CS9901
    }
}
