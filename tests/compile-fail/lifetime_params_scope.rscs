// A borrow stored in slot 'b must outlive the Pair. C#'s ref safety rules already reject this (CS8352),
// before the borrow checker runs.
using System;

ref struct Pair<'a, 'b>
{
    public ref readonly 'a int X;
    public ref readonly 'b int Y;
    public Pair(ref readonly 'a int x, ref readonly 'b int y) { X = ref x; Y = ref y; }
}

class P
{
    static void YTooShort()
    {
        mut int x = 1;
        mut Pair<'_, '_> p = new Pair<'_, '_>(in x, in x);
        {
            int y = 2;
            p = new Pair<'_, '_>(in x, in y); // error: CS8352 // error: CS8347
        }
        Console.WriteLine(p.Y);
    }

    static void Main() { }
}
